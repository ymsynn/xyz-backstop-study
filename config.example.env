# Copy to config.env (git-ignored) and fill in. Read by the launchers in ec2/.
# Everything on AWS runs in ap-northeast-1: both raw archives live there, so reads from an instance are free of transfer cost.
REGION=ap-northeast-1
# An S3 bucket you own in that region: the jobs write their tables, rebuilt market-days and results under s3://$BUCKET/backstop/
BUCKET=
# An EC2 instance profile whose role may: read s3://hl-mainnet-node-data and s3://hydromancer-reservoir (both requester-pays),
# read and write s3://$BUCKET, and terminate its own instance (ec2:TerminateInstances), which every job does when it ends.
INSTANCE_PROFILE=
